# Choose ONE primary LLM provider; the wrapper supports both transparently.
# Anthropic (recommended — strong reasoning + RAG performance)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (fallback / for model-comparison in NLP block)
OPENAI_API_KEY=sk-...

# Default provider used by the app ("anthropic" | "openai")
LLM_PROVIDER=anthropic

# Model names per provider (override at will)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# Optional: Cohere reranker (Variant C in NLP comparison)
COHERE_API_KEY=

# Hugging Face (for pushing model artifacts to a private/public model repo)
HF_TOKEN=

# Random seed for reproducibility
SEED=42
